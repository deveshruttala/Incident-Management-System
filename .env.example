# Backend env (used inside docker-compose; copy to .env to override)

# ---- storage ----------------------------------------------------------------
POSTGRES_DSN=postgresql://ims:ims@postgres:5432/ims
MONGO_URI=mongodb://mongo:27017
MONGO_DB=ims
REDIS_URL=redis://redis:6379/0

# ---- ingestion / backpressure ----------------------------------------------
LOG_LEVEL=INFO
QUEUE_MAX_SIZE=50000
WORKER_COUNT=8
DEBOUNCE_WINDOW_SECONDS=10
DEBOUNCE_MAX_SIGNALS=100
RATE_LIMIT_PER_SECOND=12000
RATE_LIMIT_BURST=20000
METRICS_PRINT_INTERVAL_SECONDS=5

# ---- security --------------------------------------------------------------
# Leave INGEST_API_KEY empty to disable auth (local dev). In production,
# set it to a long random string and pass `X-API-Key: <value>` on /ingest*.
#   openssl rand -hex 32
INGEST_API_KEY=
# Comma-separated list of allowed CORS origins. `*` for any.
CORS_ALLOW_ORIGINS=*
# Hard cap on request body size (bytes). Default = 1 MiB.
MAX_REQUEST_BODY_BYTES=1048576
